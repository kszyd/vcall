# VCall 部署环境变量示例，复制为 .env 后按需修改
# 管理后台账号
VCALL_ADMIN_USER=admin
VCALL_ADMIN_PASSWORD=vcall@2026
# 令牌签名密钥，务必改成随机长字符串
VCALL_ADMIN_SECRET=please-change-this-secret

# 单房间最大人数（1 对 1 通话保持 2）
VCALL_MAX_ROOM_MEMBERS=2

# 客户端公告（显示在 App 加入页）
VCALL_ANNOUNCEMENT=

# 可选：STUN / TURN。纯内网直连可留空
# VCALL_STUN_URLS=stun:stun.l.google.com:19302
# VCALL_TURN_URL=turn:192.168.199.100:3478
# VCALL_TURN_USER=vcall
# VCALL_TURN_PASS=your-turn-password

VCALL_LOG_LEVEL=info
TZ=Asia/Shanghai
