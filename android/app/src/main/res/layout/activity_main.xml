<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ==================== 登录 ==================== -->
    <ScrollView
        android:id="@+id/loginPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_avatar">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="V"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/setup_title"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/VCallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_server" />

                <EditText
                    android:id="@+id/serverInput"
                    style="@style/VCallInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_server"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />

                <TextView
                    style="@style/VCallLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_name" />

                <EditText
                    android:id="@+id/nameInput"
                    style="@style/VCallInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_name"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="24" />

                <Button
                    android:id="@+id/joinButton"
                    style="@style/VCallButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/join_room"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/setupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/announcementText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#FFFCD34D"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_hint"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== 通讯录 ==================== -->
    <LinearLayout
        android:id="@+id/directoryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar">

                <TextView
                    android:id="@+id/myAvatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="V"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/myName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ctrl_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="@string/directory_title"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/myState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/online"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/logoutButton"
                style="@style/VCallButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="@string/logout"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchInput"
                style="@style/VCallInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/callSelectedButton"
                style="@style/VCallButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:minWidth="0dp"
                android:text="@string/call_selected"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/listHead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/online_terminals"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/terminalList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/no_terminals"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ==================== 通话 ==================== -->
    <FrameLayout
        android:id="@+id/callPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/remoteGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="1"
            android:rowCount="1"
            android:useDefaultMargins="false" />

        <LinearLayout
            android:id="@+id/callTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_top_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/callTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/call_title"
                android:textColor="@color/white"
                android:textSize="@dimen/call_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/callTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="00:00"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/call_sub_size" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/netStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_checking"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/fullscreenButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_badge"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/fullscreen"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/localContainer"
            android:layout_width="@dimen/local_width"
            android:layout_height="@dimen/local_height"
            android:layout_gravity="top|end"
            android:layout_marginTop="76dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_local_frame"
            android:elevation="8dp">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/localRenderer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="28dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/micButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ctrl_focus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/micIcon"
                    android:layout_width="@dimen/ctrl_icon_size"
                    android:layout_height="@dimen/ctrl_icon_size"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="@string/mic_on"
                    android:padding="@dimen/ctrl_icon_padding"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/micLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/mic_on"
                    android:textColor="@color/white"
                    android:textSize="@dimen/ctrl_label_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/switchButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ctrl_focus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/switchIcon"
                    android:layout_width="@dimen/ctrl_icon_size"
                    android:layout_height="@dimen/ctrl_icon_size"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="@string/switch_camera"
                    android:padding="@dimen/ctrl_icon_padding"
                    android:src="@drawable/ic_flip_camera"
                    android:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/switch_camera"
                    android:textColor="@color/white"
                    android:textSize="@dimen/ctrl_label_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hangupButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ctrl_focus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/hangupIcon"
                    android:layout_width="@dimen/hangup_icon_size"
                    android:layout_height="@dimen/hangup_icon_size"
                    android:background="@drawable/bg_circle_danger"
                    android:contentDescription="@string/hangup"
                    android:padding="18dp"
                    android:src="@drawable/ic_call_end"
                    android:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hangup"
                    android:textColor="@color/white"
                    android:textSize="@dimen/ctrl_label_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/speakerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ctrl_focus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/speakerIcon"
                    android:layout_width="@dimen/ctrl_icon_size"
                    android:layout_height="@dimen/ctrl_icon_size"
                    android:background="@drawable/bg_circle_dark"
                    android:contentDescription="@string/speaker"
                    android:padding="@dimen/ctrl_icon_padding"
                    android:src="@drawable/ic_volume_up"
                    android:tint="@color/white" />

                <TextView
                    android:id="@+id/speakerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/speaker"
                    android:textColor="@color/white"
                    android:textSize="@dimen/ctrl_label_size" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hintOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="150dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ==================== 来电 ==================== -->
    <LinearLayout
        android:id="@+id/incomingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F205080F"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="@drawable/bg_avatar">

            <TextView
                android:id="@+id/incomingAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="V"
                android:textColor="@color/white"
                android:textSize="@dimen/avatar_text_size"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/incomingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/call_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incomingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/incoming_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rejectButton"
                style="@style/VCallButton.Danger"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="@string/reject"
                android:textSize="15sp" />

            <Button
                android:id="@+id/acceptButton"
                style="@style/VCallButton.Primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/accept"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
