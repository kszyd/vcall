<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2563EB" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FF93C5FD" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1D4ED8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FF60A5FA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A2740" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FF2A3A57" />
        </shape>
    </item>
</selector>
