<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF38BDF8" android:endColor="#FF2563EB" android:angle="0" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFBAE6FD" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1D4ED8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF0EA5E9" android:endColor="#FF2563EB" android:angle="0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
