<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF3DDC84" android:endColor="#FF07C160" android:angle="0" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFD9FFE9" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF06AD56" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF0BCE6A" android:endColor="#FF07C160" android:angle="0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
